# Base URL of the FastAPI research API.
# Leave empty in development to use the Vite proxy (/api -> http://localhost:8000).
# In production set this to the deployed API origin, e.g. https://api.example.edu
VITE_API_BASE_URL=

# Optional: override the dev proxy target (defaults to http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000
