# Secrets — never commit API keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Generated pipeline outputs (regenerable). Everything under data/ is ignored...
data/*
# ...except the committed synthetic fixtures, so tests pass on a fresh checkout.
!data/fixtures/
!data/fixtures/**
