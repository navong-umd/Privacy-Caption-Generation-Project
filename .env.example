# Copy to .env (which is gitignored) and fill in real values. NEVER commit the real .env.
# AndroZoo API key (request at https://androzoo.uni.lu/access):
ANDRO_ZOO_KEY=your-androzoo-api-key-here

# Optional LLM keys for real caption generation (Step 3); default provider is offline 'mock'.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional Neo4j viewer (DISPLAY.md). Pick your own password (8+ characters) and start the
# container with NEO4J_AUTH=neo4j/<that password>.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
